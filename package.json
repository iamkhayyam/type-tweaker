{
  "name": "type-tweaker",
  "version": "0.1.1",
  "description": "A draggable, dependency-free dev panel for auditioning fonts live on the page by hot-swapping CSS custom properties.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "demo:dev": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts",
    "demo:preview": "vite preview --config demo/vite.config.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react",
    "fonts",
    "typography",
    "design-tools",
    "google-fonts",
    "css-variables",
    "dev-tools",
    "font-picker"
  ],
  "author": "iamkhayyam",
  "license": "MIT",
  "homepage": "https://iamkhayyam.github.io/type-tweaker/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamkhayyam/type-tweaker.git"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vite": "^6.0.0",
    "@vitejs/plugin-react": "^4.3.0"
  }
}
